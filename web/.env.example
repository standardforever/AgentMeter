# Copy to web/.env.local (never commit it). `make local-stack` writes one for the local fork.

# Which networks the dashboard offers, comma-separated. The first is the default.
#   aevum = QDay Aevum testnet (chain 44005)
#   fork  = `make fork`: local copy of Aevum on 127.0.0.1:8555 (chain 440050, real tUSD8)
#   local = `make anvil`: empty local chain on 127.0.0.1:8545 (chain 31337, MockUSD8)
NEXT_PUBLIC_NETWORKS=aevum

# Your AgentMandate on each network (printed by `make deploy-mandate-aevum`).
NEXT_PUBLIC_MANDATE_AEVUM=
NEXT_PUBLIC_MANDATE_FORK=
NEXT_PUBLIC_MANDATE_LOCAL=

# The block each contract was deployed in. The dashboard reads the contract's history from here,
# 1,000 blocks per request. Without it, it only looks back about two days.
NEXT_PUBLIC_MANDATE_DEPLOY_BLOCK_AEVUM=
NEXT_PUBLIC_MANDATE_DEPLOY_BLOCK_FORK=
NEXT_PUBLIC_MANDATE_DEPLOY_BLOCK_LOCAL=

# Optional. Your facilitator's address. Refused payments never reach the chain, so the dashboard
# reads them (and the request URLs behind paid ones) from the facilitator's /activity feed.
NEXT_PUBLIC_FACILITATOR_URL=

# Local testing only: lets the dashboard act as this address without a browser wallet, by asking
# the local node to sign. Works only on `make fork` / `make anvil` with anvil's built-in accounts,
# and is ignored whenever aevum is in NEXT_PUBLIC_NETWORKS.
NEXT_PUBLIC_DEV_TEST_WALLET=

# Optional. Enables WalletConnect (mobile wallets via QR). Free at https://cloud.reown.com
# Without it the dashboard still works with browser-extension wallets (MetaMask, Rabby, ...).
NEXT_PUBLIC_WC_PROJECT_ID=

# Optional. Where the footer's "Source code" link points (your fork).
NEXT_PUBLIC_REPO_URL=
