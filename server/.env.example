# Copy to server/.env (never commit it). `make demo-phase2` does not need this file: it sets everything itself.
# Use throwaway TEST wallets only.

# Chain: Aevum testnet by default; http://127.0.0.1:8555 for `make fork`.
RPC_URL=https://rpc-test.qday.info

# Your deployed AgentMandate and the mandate the agent spends from.
MANDATE_ADDRESS=
MANDATE_ID=1

# Facilitator: submits payments and pays gas (needs a little tQDAY, no tUSD8).
FACILITATOR_KEY=
FACILITATOR_PORT=4021

# Seller: receives tUSD8 and attests answers (needs a little tQDAY for attest).
SELLER_KEY=
SELLER_PORT=4020
FACILITATOR_URL=http://localhost:4021
# Demo only: add a prompt-injection headline to /v1/news pointing at this URL.
NEWS_INJECTION_URL=

# Agent: only signs. Needs no tUSD8 and no tQDAY.
AGENT_KEY=
SELLER_URL=http://localhost:4020

# Optional: let Claude choose which APIs to call, and write real summaries.
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-haiku-5-5
